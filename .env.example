# Local demo key; replace with unique, high-entropy values outside development.
API_KEYS=local-dev-key:demo-user:admin:engineering
DATABASE_URL=sqlite:///./data/audit.db
# Optional production/shared services:
# DATABASE_URL=postgresql+psycopg://gateway:change-me@localhost:5432/gateway
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT=30
RATE_WINDOW_SECONDS=60
# Optional OpenAI-compatible provider endpoint, e.g. https://api.openai.com/v1
# UPSTREAM_BASE_URL=
# UPSTREAM_API_KEY=
REQUEST_TIMEOUT_SECONDS=30
